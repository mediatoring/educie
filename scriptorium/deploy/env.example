PUBLISHER_USER=admin
# python3 auth.py <PIN>
PUBLISHER_PIN_HASH=pbkdf2:...
# python3 -c "import secrets;print(secrets.token_hex(32))"
PUBLISHER_SECRET=
# ochrana přihlášení: 5 chybných pokusů z jedné adresy = blokace na LOGIN_BAN_HOURS hodin;
# LOGIN_GLOBAL_FAILS chybných pokusů z různých adres za hodinu = přihlašování zastaveno na LOGIN_GLOBAL_LOCK_MINUTES
LOGIN_BAN_HOURS=24
LOGIN_GLOBAL_FAILS=20
LOGIN_GLOBAL_LOCK_MINUTES=60
# kam poslat upozornění na blokaci (prázdné = SUPPORT_EMAIL_TO; posílá se jen při nastaveném SMTP)
SECURITY_ALERT_EMAIL=
# cookie jen přes HTTPS (na serveru za reverzní proxy nechat 1)
PUBLISHER_SECURE_COOKIE=1
PUBLISHER_DATA=/opt/publisher/data
PUBLISHER_HOST=127.0.0.1
PUBLISHER_PORT=2209
# jazykový model pro sloupec Dotaz (OpenAI-kompatibilní API)
LLM_BASE_URL=http://127.0.0.1:18080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_VERIFY_TLS=1
# hlášení z formuláře Podpora: e-mailem (např. do CRM) a/nebo jako GitHub issue
SUPPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_GITHUB_REPO=
SUPPORT_GITHUB_TOKEN=
